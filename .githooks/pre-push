#!/bin/sh
# 푸시가 GitHub 로 나가기 전에, 올리려는 커밋이 새로 들이는 파일을 전부 본다
# (중간 커밋에만 있다가 지운 값도 기록에 남아 나간다 — 공개 저장소라 되돌릴 수 없다).
# 켜기: npm run hooks:install (이 컴퓨터에 한 번). 규칙은 scripts/validate-secrets.mjs.
PATH="$PATH:/opt/homebrew/bin:/usr/local/bin"
command -v node >/dev/null 2>&1 || { echo "pre-push: node 를 찾지 못해 비밀값 검사를 못 했다 — 푸시를 멈춘다" >&2; exit 1; }
root=$(git rev-parse --show-toplevel)
# 그 원격이 이미 가진 커밋은 빼고 본다. 원격을 주소로 적었으면 아는 원격 전부를 뺀다
case "$1" in *[!A-Za-z0-9._-]*|"") known="--remotes" ;; *) known="--remotes=$1" ;; esac
status=0
while read -r _ref sha _remote_ref _remote_sha; do
  case "$sha" in *[!0]*) ;; *) continue ;; esac   # 브랜치를 지우는 푸시
  node "$root/scripts/validate-secrets.mjs" --range "$sha" --not "$known" </dev/null || status=1
done
exit $status
